#include <iostream>
using namespace std;

int main()
{
    int a[5], i, j, min, temp;

    cout << "Enter 5 elements: ";

    for (i = 0; i < 5; i++)
    {
        cin >> a[i];
    }

    for (i = 0; i < 4; i++)
    {
        min = i;

        for (j = i + 1; j < 5; j++)
        {
            if (a[j] < a[min])
            {
                min = j;
            }
        }

        temp = a[i];
        a[i] = a[min];
        a[min] = temp;
    }

    cout << "Sorted Array: ";

    for (i = 0; i < 5; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
